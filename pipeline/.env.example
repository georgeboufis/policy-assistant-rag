# Copy this file to .env in this folder, then paste in your key.
# A free key from https://console.groq.com/ is enough.

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Alternatives that have worked on the free tier:
#   openai/gpt-oss-20b     smaller and quicker; best on the question battery
#   qwen/qwen3.8-27b       a spare when the others run out of tokens for the day
